Route14_Text_JanPostBattle_ES::
    .string "TEA: ¡LENA, no llores! ¡Ya lo\n"
    .string "haremos mejor la próxima vez!$"

Route14_Text_JanNotEnoughMons_ES::
    .string "TEA: ¿Quieres luchar?\n"
    .string "¡Te hacen falta dos POKéMON!$"
