RockTunnel_1F_Text_LennyIntro_IT::
    .string "Questo cunicolo è molto\n"
    .string "lungo, sai?!$"

RockTunnel_1F_Text_LennyDefeat_IT::
    .string "No!\n"
    .string "Hai vinto!$"

RockTunnel_1F_Text_LennyPostBattle_IT::
    .string "Attento a ONIX.\n"
    .string "Ogni tanto ne appaiono di molto\l"
    .string "forti e pericolosi!$"

RockTunnel_1F_Text_OliverIntro_IT::
    .string "Mhm.\n"
    .string "Forse mi sono perso…$"

RockTunnel_1F_Text_OliverDefeat_IT::
    .string "Stiamo calmi!\n"
    .string "Che sto facendo?\l"
    .string "Da dove si esce?$"

RockTunnel_1F_Text_OliverPostBattle_IT::
    .string "Quel POKéMON addormentato sul\n"
    .string "PERCORSO 12 mi ha fatto deviare.$"

RockTunnel_1F_Text_LucasIntro_IT::
    .string "I forestieri come te mi devono\n"
    .string "rispetto!$"

RockTunnel_1F_Text_LucasDefeat_IT::
    .string "Mi arrendo!$"

RockTunnel_1F_Text_LucasPostBattle_IT::
    .string "Dovresti venire a fare qualche\n"
    .string "escursione con me!$"

RockTunnel_1F_Text_AshtonIntro_IT::
    .string "Lotta POKéMON!\n"
    .string "Pronti… via!$"

RockTunnel_1F_Text_AshtonDefeat_IT::
