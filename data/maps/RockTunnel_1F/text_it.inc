RockTunnel_1F_Text_DanaPostBattle_IT::
    .string "Parevi un piccolo essere indifeso!$"

RockTunnel_1F_Text_ArianaIntro_IT::
    .string "Hai dei POKéMON?!\n"
    .string "Cominciamo!$"

RockTunnel_1F_Text_ArianaDefeat_IT::
    .string "Giochi duro!$"

RockTunnel_1F_Text_ArianaPostBattle_IT::
    .string "Uffa!\n"
    .string "Sono tutta sudata!$"

RockTunnel_1F_Text_RouteSign_IT::
