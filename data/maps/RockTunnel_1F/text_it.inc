RockTunnel_1F_Text_LeahPostBattle_IT::
    .string "Ho visto un MACHOP in questo\n"
    .string "tunnel!$"

RockTunnel_1F_Text_DanaIntro_IT::
    .string "Sono giunta fin qui per i POKéMON!$"

RockTunnel_1F_Text_DanaDefeat_IT::
