	.string "heraus?$"

MtMoon_1F_Text_JovanIntro_DE::
	.string "Heh!\n"
	.string "Schleich nicht so herum!$"

MtMoon_1F_Text_JovanDefeat_DE::
	.string "Meine POKéMON bringen es nicht!$"

MtMoon_1F_Text_JovanPostBattle_DE::
	.string "Ich muss stärkere POKéMON fangen!$"

MtMoon_1F_Text_IrisIntro_DE::
