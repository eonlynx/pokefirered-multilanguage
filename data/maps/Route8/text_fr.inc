Route8_Text_AnnePostBattle_FR::
	.string "ANNE: Je dresse mes POKéMON\n"
	.string "avec ELI.$"

Route8_Text_AnneNotEnoughMons_FR::
	.string "ANNE: Hi, hi. Si tu veux combattre,\n"
	.string "il te faut deux POKéMON.$"

