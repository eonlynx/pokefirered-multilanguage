Route13_Text_SebastianIntro_ES::
    .string "¡Mis pájaros POKéMON quieren\n"
    .string "pelear!$"

Route13_Text_SebastianDefeat_ES::
    .string "¿Perdió mi combinación de pájaros?$"

Route13_Text_SebastianPostBattle_ES::
