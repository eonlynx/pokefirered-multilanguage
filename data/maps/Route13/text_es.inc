    .string "POKéMON para fortalecerlos!$"

Route13_Text_AlmaIntro_ES::
    .string "¡Una vez encontré CARBURANTE\n"
    .string "en una cueva!$"

Route13_Text_AlmaDefeat_ES::
    .string "¡Lo he hecho fatal!$"

Route13_Text_AlmaPostBattle_ES::
